@model Proyecto_Estadias.Models.Empleados

@{
    ViewBag.Title = "Registrar Empleado";
}

<h2>Registrar Empleado</h2>

@using (Html.BeginForm("InsertarEmpleado", "Empleados", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.NumEmpleado)
        @Html.TextBoxFor(m => m.NumEmpleado, new { @class = "form-control" })
    </div>
    
    <div class="form-group">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaIDeIngreso)
        @Html.TextBoxFor(m => m.FechaIDeIngreso, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.IdEmpresa)
        @Html.DropDownListFor(m => m.IdEmpresa, (SelectList)ViewBag.Empresas, "Selecciona una empresa", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
}
