@model List<Proyecto_Estadias.Models.Permisos>

@{
    ViewBag.Title = "Reporte de Faltas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reporte de Faltas</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Empleado</th>
            <th>Empresa</th>
            <th>Motivo de Ausencia</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var permiso in Model)
        {
            <tr>
                <td>@permiso.Empleados.Nombre</td>
                <td>@permiso.Empresas.Nombre</td>
                <td>@permiso.MotivosAusencia.NombreMotivo</td>
                <td>@permiso.FechaGeneracion.ToShortDateString()</td>
            </tr>
        }
        @Html.ActionLink("generar reporte", "GenerarPDF", "Permisos", null, new { @class = "btn btn-dark btn-group-sm w-25" })
    </tbody>

</table>
