@model PagedList.IPagedList<Proyecto_Estadias.ViewModels.PermisosPdfVM>
    @using PagedList.Mvc
@{
    ViewBag.Title = "Paginacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="card shadow-lg p-3 mb-5 bg-body rounded">
            <div class="card-body">
                <div class="card-header">Listado de permisos para super administrador</div>
                <div class="card-text">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                            <table class=" table table-striped table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Numero empleado</th>
                                        <th>Empleado</th>
                                        <th>Empresa</th>
                                        <th>Motivo de Ausencia</th>
                                        <th>Fecha Generacion</th>
                                        <th>Inicio</th>
                                        <th>Final</th>
                                        <th>Generales</th>
                                        <th>individuales</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaPermisos">
                                    @foreach (var p in Model)
                                    {
                                        <tr>
                                            <td>@p.Empleados.NumEmpleado</td>
                                            <td>@p.Empleados.Nombre</td>
                                            <td>@p.SubEmpresas.Nombre</td>
                                            <td>@p.MotivosAusencia.NombreMotivo</td>
                                            <td>@p.FechaGeneracion.ToString("dd/MM/yyyy")</td>
                                            <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@p.FechaFinal.ToString("dd/MM/yyyy")</td>
                                            <td>@Html.ActionLink("GenerarPdf", "GenerarPDFEmpleado", "Permisos", new { id = p.IdEmpleado }, new { @class = "btn btn-primary btn-sm" })</td>
                                            <td>
                                                <a href="@Url.Action("GenerarPDFPermiso", "Permisos", new { idPermiso = p.Id })" class="btn btn-success btn-sm" target="_blank">🖨️ Imprimir</a>
                                            </td>
                                        </tr>

                                    }
                                    @Html.ActionLink("generar reporte", "GenerarPDF", "Permisos", null, new { @class = "btn btn-dark btn-group-sm w-25" })
                             

                                </tbody>
                            </table>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                            <div id="paginacion">
                                @Html.PagedListPager(Model, page => Url.Action("Paginacion", new { page = page }), new PagedListRenderOptions
                           {
                               DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                               DisplayLinkToLastPage = PagedListDisplayMode.Always,
                               DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                               DisplayLinkToNextPage = PagedListDisplayMode.Always,
                               DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                               MaximumPageNumbersToDisplay = 5 ,
                               ContainerDivClasses = new[] { "pagination-container" },
                               UlElementClasses = new[] { "pagination" },
                               LiElementClasses = new[] { "page-item" }
                           })
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<Link href="~/Content/paginacion.css" rel="stylesheet" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#pagination a").on("click", function (e) {
                e.preventDefault();
                var url = $(this).attr("href");
                cargarDatos(url);
            });
        });

        function cargarDatos(url) {
            $.get(url, function (data) {
                var html = $(data).find("#tablapermisos").html();
                $("#tablaPermisos").html(html);
                var pagination = $(data).find("#pagination").html();
                $("#pagination").html(pagination);
            });
        }</script>
    }
