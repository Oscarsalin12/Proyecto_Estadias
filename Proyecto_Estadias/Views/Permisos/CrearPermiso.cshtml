@model Proyecto_Estadias.ViewModels.PermisosVM

@{
    ViewBag.Title = "Registrar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Registrar Permiso</h2>

@using (Html.BeginForm("CrearPermiso", "Permisos", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Buscar empleado por Nombre o Número</label>
        <input type="text" id="busquedaEmpleado" class="form-control"
               placeholder="Ej. Juan o 123"
               autocomplete="off"
               value="@Model.NombreEmpleado"
               @(Model.IdEmpleado > 0 ? "readonly" : "") />

        @Html.HiddenFor(m => m.IdEmpleado)
        @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
    </div>

    <div id="datosEmpleado" style="margin-bottom:15px;">
        @Html.HiddenFor(m => m.IdEmpresa)
        <p><strong>Empresa:</strong> <span id="empresa">@Model.EmpresaNombre</span></p>
        <p><strong>Días de Vacaciones:</strong> <span id="vacaciones">@Model.VacacionesDisponibles</span></p>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.IdTipoPermiso)
        <select id="IdTipoPermiso" name="IdTipoPermiso" class="form-control">
            <option value="">Seleccione el motivo</option>
            @foreach (var motivo in Model.MotivosAusencia)
            {
                <option value="@motivo.Id">@motivo.NombreMotivo</option>
            }
        </select>
        @Html.ValidationMessageFor(m => m.IdTipoPermiso, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaInicio, "Fecha de inicio")
        @Html.TextBoxFor(m => m.FechaInicio, new { @type = "date", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaFinal, "Fecha final")
        @Html.TextBoxFor(m => m.FechaFinal, new { @type = "date", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FechaFinal, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar Permiso</button>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

    <script>
        $(function () {
            // Solo activa el autocomplete si el campo no está readonly
            if (!$('#busquedaEmpleado').prop('readonly')) {
                $('#busquedaEmpleado').autocomplete({
                    source: function (request, response) {
                        $.ajax({
                            url: '@Url.Action("BuscarEmpleado", "Permisos")',
                            data: { filtro: request.term },
                            success: function (data) {
                                if (data) {
                                    response([{
                                        label: data.nombre + " (" + data.numEmpleado + ")",
                                        value: data.nombre,
                                        id: data.id,
                                        empresa: data.empresa,
                                        vacaciones: data.vacaciones,
                                        empresaId: data.empresaId
                                    }]);
                                } else {
                                    response([]);
                                }
                            }
                        });
                    },
                    minLength: 2,
                    select: function (event, ui) {
                        console.log(ui.item);
                        $('#IdEmpleado').val(ui.item.id);
                        $('#empresa').text(ui.item.empresa);
                        $('#vacaciones').text(ui.item.vacaciones);
                        $('#IdEmpresa').val(ui.item.empresaId);
                    }
                });
            }
        });
    </script>
}
