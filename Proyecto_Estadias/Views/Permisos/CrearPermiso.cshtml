@model Proyecto_Estadias.ViewModels.PermisosVM

@{
    ViewBag.Title = "Registrar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Registrar Permiso</h2>

@using (Html.BeginForm("CrearPermiso", "Permisos", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.IdEmpleado)
      <select id="IdEmpleado" name="IdEmpleado" class="form-control" onchange="cargarDatosEmpleado()">
          <option value="">Seleccione un Empleado</option>
          @foreach (var emp in Model.Empleados)
                {
                    <option value="@emp.Id">@emp.Nombre</option>
                }
      </select>
    </div>

    <div id="datosEmpleado" style="margin-bottom:15px;">
        @Html.HiddenFor(m => m.IdEmpresa)
        <p><strong>Empresa:</strong> <span id="empresa"></span></p>
        <p><strong>Días de Vacaciones:</strong> <span id="vacaciones"></span></p>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.IdTipoPermiso)
        <select id="IdTipoPermiso" name="IdTipoPermiso" class="form-control">
            <option value="">Seleccione El Motivo</option>
            @foreach (var motivo in Model.MotivosAusencia)
                {
                    <option value="@motivo.Id">@motivo.NombreMotivo</option>
                }
        </select>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaInicio, "Fecha de inicio")
        @Html.TextBoxFor(m => m.FechaInicio, Model.FechaInicio != DateTime.MinValue ? Model.FechaInicio.ToString("yyyy-MM-dd") : "", new { @type = "date", @class = "form-control" })

    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaFinal, "Fecha final")
      @Html.TextBoxFor(m => m.FechaFinal, Model.FechaFinal != DateTime.MinValue ? Model.FechaFinal.ToString("yyyy-MM-dd") : "", new { @type = "date", @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar Permiso</button>
}

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        function cargarDatosEmpleado() {
            var empleadoId = $('#IdEmpleado').val();
            if (empleadoId) {
                $.get('@Url.Action("ObtenerDatosEmpleado","Permisos")',
                    { id: empleadoId },
                    function (data) {

                        $('#empresa').text(data.empresa);
                        $('#vacaciones').text(data.vacaciones);
                        $('#IdEmpresa').val(data.empresaId);
                    });
            } else {
                $('#empresa').text('');
                $('#vacaciones').text('');
            }
        }
    </script>
}
