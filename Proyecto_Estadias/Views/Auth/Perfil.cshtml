@model Proyecto_Estadias.ViewModels.PerfilVM

@{
    ViewBag.Title = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Bienvenido, @Model.Usuario.Usuario</h2>

<h3>Empresas</h3>

<div class="row">
    @foreach (var empresa in Model.Empresas)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="~/Content/imagenes/empresas/@(empresa.Id).jpg" class="card-img-top" alt="Imagen de @empresa.Nombre" style="height:200px; object-fit:cover;" />
                <div class="card-body text-center">
                    <h5 class="card-title">@empresa.Nombre</h5>
                    @Html.ActionLink("Ver empleados", "EmpleadosPorEmpresa", "Auth", new { id = empresa.Id }, new { @class = "btn btn-primary" })

                </div>
            </div>

        </div>

    }

    @Html.ActionLink("asignar Roles", "AsignarRol", "Auth", new { id = Model.Usuario.Id }, new { @class = "btn btn-primary" })
    Asignar Rol
</div>
