@model Proyecto_Estadias.ViewModels.PerfilVM
@using Proyecto_Estadias.Helpers
@{
    ViewBag.Title = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var identity = (System.Security.Claims.ClaimsIdentity)User.Identity;
}

<div class="container profile-container">
    <div class="profile-header text-center">
        <h2 class="mb-2">Bienvenido, @Model.Usuario.Usuario</h2>
        <p class="profile-subtitle">Selecciona una empresa para ver sus SubEmpresas</p>
    </div>

    <div class="text-end mb-4">
        <a href="@Url.Action("InsertarEmpresa", "Empresas")" class="btn btn-gradient">
            ➕ Agregar Empresa
        </a>
    </div>

    <div class="row justify-content-center">
        @foreach (var empresa in Model.Empresas)
        {
            <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                <div class="card card-company w-100">
                    <img src="@(empresa.Logo != null
                        ? $"data:image/png;base64,{Convert.ToBase64String(empresa.Logo)}"
                        : Url.Content("~/Content/imagenes/empresas/default.jpg"))"
                         alt="Logo de @empresa.Nombre"
                           style="max-height: 180px; object-fit: contain; padding: 10px;"
                         class="card-img-top" />

                    <div class="card-body text-center d-flex flex-column">
                        <h5 class="card-title">@empresa.Nombre</h5>
                        <p class="card-text mb-1"><strong>RFC:</strong> @empresa.Rfc</p>
                        <p class="card-text mb-3"><strong>Dirección:</strong> @empresa.Direccion</p>
                        <div class="mt-auto">
                            @Html.ActionLink("Ver Filiales", "SeleccionarSubempresa", "Auth",
                                new { id = empresa.Id },
                                new { @class = "btn btn-gradient" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
                 @if (TempData["UsuarioCreado"] != null)
     {
         TempData.Keep("UsuarioCreado"); // esto marca el tempData como leida y no volvera a aparecer
         @:toastr.success('Usuario Creado exitosamente', 'Éxito');
         TempData.Remove("UsuarioCreado"); // se elimina despues de mostrarse
     }
        });

            @if (TempData["ExitoSub"] != null)
            {
                TempData.Keep("ExitoSub");
                @:toastr.success('Sub empresa creada correctamente ', 'Éxito');
                TempData.Remove("ExitoSub");
            }

                @if (TempData["EmpresaCreada"] != null)
            {
                TempData.Keep("EmpresaCreada");
                @:toastr.success('Empresa creada exitosamente', 'Éxito');
                TempData.Remove("EmpresaCreada");
            }

            @if (TempData["Error404"] != null)
            {
                TempData.Keep("Error404");
                @:toastr.error('Erro inesperado', 'Error');
                TempData.Remove("Error404");
            }

            @if (TempData["ErrorIner"] != null)
            {
                TempData.Keep("ErrorIner");
                @:toastr.error('Error al insertar la SubEmpresa', 'Error');
                TempData.Remove("ErrorIner");
            }
        });
    </script>
}

<style>
    .profile-header {
      font-size: 28px;
    font-weight: 700;
    text-align: center;
    background: linear-gradient(to right, #0000ff, #4b0082);
    color: white;
    padding: 20px 15px;
    border-radius: 15px 15px 10px 10px;
    margin-bottom: 30px;
    }

    body {
        background: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .profile-container {
        max-width: 960px;
        margin: 40px auto 80px auto;
        padding: 30px;
        background-color: white;
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .profile-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: white;
    }

    .profile-subtitle {
        color: whitesmoke;
        margin-bottom: 20px;
        font-size: 1rem;
    }

    .card-company {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
    }

        .card-company:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .card-company img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .card-company .card-title {
            color: #222;
            font-weight: 600;
            margin-bottom: 10px;
        }

    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: #fff !important;
        border: none;
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #4b0082, #0000ff);
            box-shadow: 0 4px 10px rgba(75, 0, 130, 0.5);
            color: #fff !important;
        }
</style>
