@model PagedList.IPagedList<Proyecto_Estadias.ViewModels.EmpleadosVM>
@using PagedList.Mvc
@using PagedList

@{
    ViewBag.Title = "Empleados por Subempresa";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var idSub = ViewBag.IdSub ?? 0;
    var subempresaNombre = ViewBag.SubempresaNombre ?? "Subempresa";
    var departamentos = ViewBag.Departamentos as SelectList;
    var selectedDept = Request.QueryString["bus"];
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    .content-box {
        background-color: white;
        padding: 30px;
        margin: 40px auto;
        border-radius: 15px;
        max-width: 1400px; /* Ajuste aquí */
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        overflow-x: auto; /* Importante para scroll si se excede el ancho */
    }

    .content-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 22px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
    }

        .btn-primary:hover {
            background-color: #5a379e;
        }

    .btn-success {
        border-radius: 8px;
    }

    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 500;
        transition: background 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #5a379e, #0000ff);
            color: white;
        }

    table.table {
        border: 1px solid #dee2e6;
    }

    table th, table td {
        text-align: center;
        vertical-align: middle;
    }

    table thead {
        background-color: #343a40;
        color: white;
        margin-top: 15px;
        border: none;
    }

    .pagination {
        margin-top: 30px;
    }

        .pagination li {
            display: inline-block;
            margin: 0 3px;
        }

        .pagination a,
        .pagination span {
            padding: 6px 12px;
            border: 1px solid #ddd;
            color: #007bff;
            text-decoration: none;
            border-radius: 5px;
        }

        .pagination .active span {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

    .table-responsive {
        overflow-x: auto;
        width: 100%;
    }
</style>

@Html.ActionLink("Ver Empleados", "ListaEmpleadosSubempresa", "Auth", new { idSub = idSub }, new { @class = "btn btn-gradient" })

<div class="content-box">
    <div class="content-header">
        Empleados de @subempresaNombre
    </div>

    @using (Html.BeginForm("ListaEmpleadosDadosDeBaja", "Auth", FormMethod.Get, new { area = "Auth" }))
    {
        <input type="hidden" name="idSub" value="@idSub" />

        <div class="form-group row">
            <label class="col-sm-4 col-form-label">Filtrar por departamento:</label>
            <div class="col-sm-5">
                @Html.DropDownList("bus", new SelectList(departamentos, "Value", "Text", selectedDept),
                    "Todos", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group row mt-3">
            <label class="col-sm-4 col-form-label">Búsqueda por nombre:</label>
            <div class="col-sm-5">
                @Html.TextBox("busqueda", null, new { @class = "form-control", placeholder = "Nombre del empleado" })
            </div>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
            <a href="@Url.Action("ListaEmpleadosDadosDeBaja", "Auth", new { area = "Auth", idSub = idSub })" class="btn btn-secondary btn-sm">Limpiar</a>
        </div>
    }

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">No hay empleados para mostrar.</div>
        <div class="text-center mt-3">
            @Html.ActionLink("Añadir empleados", "InsertarEmpleado", "Empleados", new { area = "Empleado", idSub = idSub }, new { @class = "btn btn-success" })
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped w-100">
                <thead>
                    <tr>
                        <th>Num. Empleado</th>
                        <th>Nombre</th>
                        <th>Fecha de Ingreso</th>
                        <th>Departamento</th>

                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.NumEmpleado</td>
                            <td>@emp.Nombre</td>
                            <td>@emp.FechaDeIngreso.ToShortDateString()</td>
                            <td>@emp.NombreDepartamento</td>
                            <td>
                                @Html.ActionLink("Editar empleado", "EditarEmpleado", "Empleados", new { area = "Empleado", id = emp.Id }, new { @class = "btn btn-sm btn-gradient" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(
                Model,
                page => Url.Action("ListaEmpleadosDadosDeBaja", new
                {
                    idSub = idSub,
                    bus = Request["bus"],
                    busqueda = Request["busqueda"],
                    page = page
                }),
                new PagedListRenderOptions
                {
                    Display = PagedListDisplayMode.IfNeeded,
                    MaximumPageNumbersToDisplay = 5,
                    LinkToPreviousPageFormat = "«",
                    LinkToNextPageFormat = "»",
                    UlElementClasses = new[] { "pagination" },
                    LiElementClasses = new[] { "page-item" },
                }
            )
        </div>
    }
</div>

@section Scripts {
    <script>

    </script>
}
