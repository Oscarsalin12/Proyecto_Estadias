@model List<Proyecto_Estadias.ViewModels.SubEmpresasVM>

@{
    ViewBag.Title = "Selecciona una subempresa";
}

<h2>@ViewBag.EmpresaMadre - Subempresas</h2>

<ul>
    @foreach (var sub in Model)
    {
        <li>
            @Html.ActionLink(sub.Nombre, "ListaEmpleadosSubempresa", "Auth", new { idSub = sub.Id }, null)
        </li>
    }
</ul>
