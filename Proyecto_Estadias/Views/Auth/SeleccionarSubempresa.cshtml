@model List<Proyecto_Estadias.ViewModels.SubEmpresasVM>

@{
    ViewBag.Title = "Selecciona una subempresa";
}

<h2 class="mb-4">@ViewBag.EmpresaMadre - Subempresas</h2>

<div class="row">
    @foreach (var sub in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">@sub.Nombre</h5>
                    <a href="@Url.Action("ListaEmpleadosSubempresa", "Auth", new { idSub = sub.Id })" class="btn btn-primary">
                        Ver Empleados
                    </a>
                </div>
            </div>
        </div>
    }
</div>
